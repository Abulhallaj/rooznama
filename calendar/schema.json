{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Abulhallaj/rooznama/calendar/schema.json",
  "title": "Rooznama Calendar Data",
  "description": "Schemas for meta, fixed rules (Jalali, Hijri, Gregorian), the official Hijri month starts, and per-year holidays/events JSON under /calendar.",
  "$defs": {
    "localizedTitle": {
      "type": "object",
      "required": ["fa"],
      "properties": {
        "fa": { "type": "string", "minLength": 1 },
        "en": { "type": "string" }
      },
      "additionalProperties": false
    },
    "jalaliDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Jalali calendar date as YYYY-MM-DD (not Gregorian)."
    },
    "holidayItem": {
      "type": "object",
      "required": ["id", "date", "title", "isHoliday"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/jalaliDate" },
        "ruleId": { "type": "string" },
        "title": { "$ref": "#/$defs/localizedTitle" },
        "isHoliday": { "type": "boolean" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "eventItem": {
      "type": "object",
      "required": ["id", "date", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/jalaliDate" },
        "title": { "$ref": "#/$defs/localizedTitle" },
        "isHoliday": { "type": "boolean", "const": false },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "fixedRuleItem": {
      "type": "object",
      "required": ["id", "month", "day", "title", "isHoliday"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": -1, "maximum": 31, "not": { "const": 0 }, "description": "1-31, or -1 for the last day of the month." },
        "title": { "$ref": "#/$defs/localizedTitle" },
        "isHoliday": { "type": "boolean" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other record ids (without the year prefix) the yearly files use for the same occasion."
        }
      },
      "additionalProperties": false
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Gregorian date as YYYY-MM-DD."
    }
  },
  "oneOf": [
    {
      "title": "YearHolidays",
      "type": "object",
      "required": ["year", "schemaVersion", "items"],
      "properties": {
        "year": { "type": "integer", "minimum": 1300, "maximum": 1600 },
        "schemaVersion": { "type": "integer", "const": 1 },
        "dataVersion": { "type": "string" },
        "source": { "type": "string" },
        "coverage": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/holidayItem" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "YearEvents",
      "type": "object",
      "required": ["year", "schemaVersion", "items"],
      "properties": {
        "year": { "type": "integer", "minimum": 1300, "maximum": 1600 },
        "schemaVersion": { "type": "integer", "const": 1 },
        "dataVersion": { "type": "string" },
        "coverage": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/eventItem" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "FixedRules",
      "type": "object",
      "required": ["schemaVersion", "items"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "calendar": { "enum": ["jalali", "hijri", "gregorian"], "description": "The calendar month/day refer to; jalali when absent." },
        "description": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/fixedRuleItem" }
        }
      },
      "additionalProperties": false
    },
    {
      "title": "HijriMonthStarts",
      "type": "object",
      "required": ["schemaVersion", "ranges", "months"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "source": { "type": "string" },
        "generatedBy": { "type": "string" },
        "jalaliYears": { "type": "array", "items": { "type": "integer" } },
        "repairedDays": { "type": "array", "items": { "type": "string" } },
        "ranges": {
          "type": "array",
          "description": "Gregorian day ranges (inclusive) the data covers.",
          "items": {
            "type": "array",
            "prefixItems": [ { "$ref": "#/$defs/isoDate" }, { "$ref": "#/$defs/isoDate" } ],
            "minItems": 2, "maxItems": 2
          }
        },
        "months": {
          "type": "array",
          "description": "[Hijri year, Hijri month, Gregorian date of day 1].",
          "items": {
            "type": "array",
            "prefixItems": [ { "type": "integer" }, { "type": "integer", "minimum": 1, "maximum": 12 }, { "$ref": "#/$defs/isoDate" } ],
            "minItems": 3, "maxItems": 3
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
