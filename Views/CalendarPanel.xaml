<UserControl
    x:Class="Rooznama.Views.CalendarPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Rooznama.Services"
    FontFamily="{StaticResource AppFontFamily}">

    <Grid RowSpacing="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- title (click: days → months → years) · Today (large mode) · up/down arrows -->
        <Grid Grid.Row="0" Height="40" ColumnSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TitleBtn" Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Background="Transparent" BorderThickness="0" Click="Title_Click">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"/>
            </Button>
            <Button x:Name="TodayBtn" Grid.Column="1" Height="32" Margin="0,0,6,0" Visibility="Collapsed"
                    Content="{x:Bind svc:Loc.T('today')}" Click="Today_Click"/>
            <Button Grid.Column="2" Width="40" Height="36" Content="&#xE70E;" FontSize="12"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    Background="Transparent" BorderThickness="0" Click="Up_Click"/>
            <Button Grid.Column="3" Width="40" Height="36" Content="&#xE70D;" FontSize="12"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    Background="Transparent" BorderThickness="0" Click="Down_Click"/>
        </Grid>

        <Grid x:Name="ViewGrid" Grid.Row="1" Height="268"/>

        <Grid Grid.Row="2" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{x:Bind svc:Loc.T('events')}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
            <Grid Grid.Row="1">
                <TextBlock x:Name="NoEvents" Text="{x:Bind svc:Loc.T('events.none')}" Opacity="0.6"/>
                <ListView x:Name="EventsList" SelectionMode="None" MaxHeight="160">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="svc:CalendarEvent">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind Title}"/>
                                <TextBlock Text="{x:Bind TimeText}" Opacity="0.7"
                                           Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
