<Page
    x:Class="Rooznama.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Rooznama.Services"
    FontFamily="{StaticResource AppFontFamily}">

    <ScrollViewer>
        <StackPanel Padding="24,16" Spacing="16" MaxWidth="680" HorizontalAlignment="Stretch">
            <TextBlock Text="{x:Bind svc:Loc.T('settings')}" Style="{StaticResource SubtitleTextBlockStyle}"/>

            <!-- Appearance -->
            <Border Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind svc:Loc.T('set.appearance')}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <Grid ColumnSpacing="16" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ComboBox x:Name="LangBox" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch"
                                  Header="{x:Bind svc:Loc.T('set.language')}" SelectionChanged="Appearance_Changed">
                            <ComboBoxItem Content="فارسی" Tag="fa"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                        <ComboBox x:Name="FontBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                  Header="{x:Bind svc:Loc.T('set.font')}" SelectionChanged="Appearance_Changed">
                            <ComboBoxItem Content="وزیرمتن (Vazirmatn)" Tag="Vazirmatn"/>
                            <ComboBoxItem Content="Tahoma" Tag="Tahoma"/>
                        </ComboBox>
                        <ComboBox x:Name="ThemeBox" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch"
                                  Header="{x:Bind svc:Loc.T('set.theme')}" SelectionChanged="Appearance_Changed">
                            <ComboBoxItem Content="{x:Bind svc:Loc.T('theme.auto')}" Tag="auto"/>
                            <ComboBoxItem Content="{x:Bind svc:Loc.T('theme.light')}" Tag="light"/>
                            <ComboBoxItem Content="{x:Bind svc:Loc.T('theme.dark')}" Tag="dark"/>
                        </ComboBox>
                    </Grid>

                    <InfoBar x:Name="RestartBar" IsOpen="False" IsClosable="False" Severity="Informational"
                             Message="{x:Bind svc:Loc.T('set.restartmsg')}">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind svc:Loc.T('set.restart')}" Click="Restart_Click"/>
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
            </Border>

            <!-- Tray icon & calendar -->
            <Border Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="{x:Bind svc:Loc.T('set.tray')}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <Grid ColumnSpacing="16" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ComboBox x:Name="ColorBox" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch"
                                  Header="{x:Bind svc:Loc.T('set.color')}" SelectionChanged="Color_Changed">
                            <ComboBoxItem Content="{x:Bind svc:Loc.T('color.blue')}" Tag="#0078D7"/>
                            <ComboBoxItem Content="{x:Bind svc:Loc.T('color.green')}" Tag="#107C10"/>
                            <ComboBoxItem Content="{x:Bind svc:Loc.T('color.red')}" Tag="#C42B1C"/>
                            <ComboBoxItem Content="{x:Bind svc:Loc.T('color.purple')}" Tag="#744DA9"/>
                            <ComboBoxItem Content="{x:Bind svc:Loc.T('color.dark')}" Tag="#2B2B2B"/>
                        </ComboBox>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind svc:Loc.T('set.startup')}" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="StartupSwitch" OnContent="{x:Bind svc:Loc.T('on')}"
                                          OffContent="{x:Bind svc:Loc.T('off')}" Toggled="Option_Toggled"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Text="{x:Bind svc:Loc.T('set.gregorian')}" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="GregorianSwitch" OnContent="{x:Bind svc:Loc.T('on')}"
                                          OffContent="{x:Bind svc:Loc.T('off')}" Toggled="Option_Toggled"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind svc:Loc.T('set.autohide')}" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="AutoHideSwitch" OnContent="{x:Bind svc:Loc.T('on')}"
                                          OffContent="{x:Bind svc:Loc.T('off')}" Toggled="Option_Toggled"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
