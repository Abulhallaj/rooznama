<Page
    x:Class="Rooznama.Views.ConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Rooznama.Services"
    FontFamily="{StaticResource AppFontFamily}">

    <StackPanel Padding="24,16" Spacing="16" MaxWidth="520" HorizontalAlignment="Stretch">
        <TextBlock Text="{x:Bind svc:Loc.T('converter')}" Style="{StaticResource SubtitleTextBlockStyle}"/>

        <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Bind svc:Loc.T('conv.shamsi')}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <CalendarDatePicker x:Name="FaPicker" CalendarIdentifier="PersianCalendar"
                                    HorizontalAlignment="Stretch" DateChanged="Fa_DateChanged"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FaNum" Opacity="0.8" VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                    <Button Grid.Column="1" Content="{x:Bind svc:Loc.T('copy')}" Click="CopyFa_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
                <TextBlock Text="{x:Bind svc:Loc.T('conv.gregorian')}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <CalendarDatePicker x:Name="GPicker" CalendarIdentifier="GregorianCalendar" Language="en-US"
                                    HorizontalAlignment="Stretch" DateChanged="G_DateChanged"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="GNum" Opacity="0.8" VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                    <Button Grid.Column="1" Content="{x:Bind svc:Loc.T('copy')}" Click="CopyG_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
