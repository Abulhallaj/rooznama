<Page
    x:Class="Rooznama.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Rooznama.Services"
    FontFamily="{StaticResource AppFontFamily}">

    <StackPanel Padding="24,32" Spacing="10" MaxWidth="460" HorizontalAlignment="Center">
        <Image Source="ms-appx:///Assets/AppIcon.png" Width="120" Height="120" HorizontalAlignment="Center"/>
        <TextBlock Text="{x:Bind svc:Loc.T('app.name')}" Style="{StaticResource TitleTextBlockStyle}"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="VersionText" Opacity="0.7" HorizontalAlignment="Center"/>
        <TextBlock x:Name="PortableText" Opacity="0.7" FontSize="12" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"/>

        <StackPanel x:Name="UpdateRow" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock x:Name="UpdateText" VerticalAlignment="Center"/>
            <HyperlinkButton x:Name="UpdateLink" Padding="4,0"/>
        </StackPanel>

        <TextBlock Text="{x:Bind svc:Loc.T('about.desc')}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock Text="{x:Bind svc:Loc.T('about.tech')}" Opacity="0.7" TextAlignment="Center"/>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
            <HyperlinkButton x:Name="ProjectLink" Content="{x:Bind svc:Loc.T('about.project')}"/>
            <HyperlinkButton x:Name="IssuesLink" Content="{x:Bind svc:Loc.T('about.issues')}"/>
        </StackPanel>

        <TextBlock x:Name="FontText" Opacity="0.5" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                   FlowDirection="LeftToRight"/>
    </StackPanel>
</Page>
