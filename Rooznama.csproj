<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Rooznama</RootNamespace>
    <AssemblyName>Rooznama</AssemblyName>
    <!-- placeholder: the release workflow passes -p:Version=<git tag without 'v'> -->
    <Version>0.0.0-dev</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Rooznama.ico</ApplicationIcon>
    <!-- default win-x64; CI passes -r win-x86 / win-x64, PlatformTarget follows the RID -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget>$(RuntimeIdentifier.Replace('win-',''))</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- the app is Persian and English only -->
    <SatelliteResourceLanguages>en;fa</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- bundled offline calendar data (holidays + observances); sources/ and *.bak are not shipped -->
  <ItemGroup>
    <Content Include="calendar\meta.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="calendar\years\**\holidays.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="calendar\years\**\events.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="calendar\rules\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="calendar\hijri\ut.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.*" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.*" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.*" />
  </ItemGroup>

  <!--
    Packages (Windows App SDK, ...) drop one folder per language next to the exe (af-ZA, de, fr, ...) with *.resources.dll / *.mui
    files. Only Persian and English are used, so those folders are deleted after build and after publish; the framework falls back to
    English for any other language. A folder is removed only if it holds such a file and is not en, en-US, fa or fa-IR.
  -->
  <Target Name="PruneLanguageFoldersAfterBuild" AfterTargets="Build">
    <ItemGroup>
      <_LangFile Include="$(OutDir)*\*.resources.dll;$(OutDir)*\*.mui"
                 Exclude="$(OutDir)en\*;$(OutDir)en-US\*;$(OutDir)fa\*;$(OutDir)fa-IR\*" />
      <_LangDir Include="@(_LangFile->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <RemoveDir Directories="@(_LangDir)" />
  </Target>

  <Target Name="PruneLanguageFoldersAfterPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_PubLangFile Include="$(PublishDir)*\*.resources.dll;$(PublishDir)*\*.mui"
                    Exclude="$(PublishDir)en\*;$(PublishDir)en-US\*;$(PublishDir)fa\*;$(PublishDir)fa-IR\*" />
      <_PubLangDir Include="@(_PubLangFile->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <RemoveDir Directories="@(_PubLangDir)" />
  </Target>

</Project>
