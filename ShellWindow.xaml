<Window
    x:Class="Rooznama.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F1" Invoked="Help_Invoked"/>
        </Grid.KeyboardAccelerators>
        <!-- LeftCompact: the pane sits on the right in RTL (like the reference screenshot) -->
        <NavigationView x:Name="Nav"
                        PaneDisplayMode="LeftCompact"
                        OpenPaneLength="200"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavCalendar" Icon="Calendar" Tag="calendar"/>
                <NavigationViewItem x:Name="NavConverter" Icon="Sync" Tag="converter"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavSupport" Tag="support">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavSettings" Icon="Setting" Tag="settings"/>
                <NavigationViewItem x:Name="NavHelp" Icon="Help" Tag="help"/>
                <NavigationViewItem x:Name="NavAbout" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
